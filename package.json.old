{
  "name": "pdf-tools-backend",
  "version": "1.0.0",
  "description": "Backend API for PDF Tools Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\""
  },
  "keywords": [
    "pdf",
    "converter",
    "api",
    "express"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
